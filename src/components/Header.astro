---
import { languages, localePath, switchLangPath, useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'ar' ? 'en' : 'ar';

const links = [
  { href: localePath(lang), label: t('nav.home') },
  { href: localePath(lang, 'work'), label: t('nav.work') },
  { href: localePath(lang, 'services'), label: t('nav.services') },
  { href: localePath(lang, 'contact'), label: t('nav.contact') },
];
const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={localePath(lang)} class="text-xl font-bold">
      {t('site.name')}<span class="text-brand">.</span>
    </a>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={['hover:text-brand transition-colors', current === l.href && 'text-brand']}
            aria-current={current === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={switchLangPath(Astro.url.pathname, other)}
          hreflang={other}
          lang={other}
          class="rounded-full border border-slate-300 px-3 py-1 hover:border-brand hover:text-brand"
        >
          {languages[other].name}
        </a>
      </li>
    </ul>
  </nav>
</header>
