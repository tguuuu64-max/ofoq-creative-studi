---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langStaticPaths, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const field = 'mt-1 w-full rounded-lg border border-slate-300 px-4 py-3 focus:border-brand focus:outline-none';
---

<BaseLayout lang={lang} title={t('contact.title')}>
  <PageHeader title={t('contact.title')} lead={t('contact.lead')} />
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <!-- TODO: connect to a form service (e.g. Formspree) or an API endpoint. -->
    <form class="max-w-xl space-y-5" method="post" action="#">
      <label class="block">
        <span class="text-sm font-medium">{t('contact.name')}</span>
        <input class={field} type="text" name="name" autocomplete="name" required />
      </label>
      <label class="block">
        <span class="text-sm font-medium">{t('contact.email')}</span>
        <input class={field} type="email" name="email" autocomplete="email" dir="ltr" required />
      </label>
      <label class="block">
        <span class="text-sm font-medium">{t('contact.message')}</span>
        <textarea class={field} name="message" rows="5" required></textarea>
      </label>
      <button type="submit" class="bg-ink rounded-full px-8 py-3 font-medium text-white hover:opacity-90">
        {t('contact.send')}
      </button>
    </form>
  </section>
</BaseLayout>
