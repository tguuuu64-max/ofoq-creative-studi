---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langStaticPaths, useTranslations, type Lang } from '../../i18n/ui';
import { services } from '../../i18n/content';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('services.title')}>
  <PageHeader title={t('services.title')} lead={t('services.lead')} />
  <section class="mx-auto max-w-6xl space-y-6 px-4 pb-20 sm:px-6">
    {services.map((s, i) => (
      <article class="flex gap-6 rounded-2xl border border-slate-200 p-6 sm:p-8">
        <span class="text-brand text-3xl font-bold">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h2 class="text-xl font-bold">{s.title[lang]}</h2>
          <p class="mt-2 text-slate-600">{s.body[lang]}</p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
